#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_BROKEN_NETWORK
	tristate "Broken network example server"
	default n
	---help---
		Enable the Broken network example server

if EXAMPLES_BROKEN_NETWORK

config EXAMPLES_BROKEN_NETWORK_PROGNAME
	string "Program name"
	default "broken_server"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_BROKEN_NETWORK_PRIORITY
	int "Broken server task priority"
	default 100

config EXAMPLES_BROKEN_NETWORK_STACKSIZE
	int "Broken server stack size"
	default DEFAULT_TASK_STACKSIZE

endif
